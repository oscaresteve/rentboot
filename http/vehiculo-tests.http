@host = http://localhost:8090
@baseUrl = {{host}}/api/vehiculos
@vehiculoId = 1
@categoriaId = 1
@ts = {{$timestamp}}
@dupMatricula = MAT-{{ts}}

### ------------------------------------------------------------
### 1) Crear vehiculo (OK)
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "marca": "Toyota",
  "modelo": "Corolla",
  "matricula": "AAA{{ts}}",
  "precioPorDia": 45.50,
  "disponible": true,
  "categoriaId": {{categoriaId}}
}

### ------------------------------------------------------------
### 2) Obtener vehiculo por id (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/{{vehiculoId}} HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 3) Listar vehiculos (paginacion + ordenacion)
### ------------------------------------------------------------
GET {{baseUrl}}?sort=marca,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 4) Filtrar vehiculos por disponible (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/disponible/true?sort=id,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 5) Actualizar vehiculo (OK)
### ------------------------------------------------------------
PUT {{baseUrl}}/{{vehiculoId}} HTTP/1.1
Content-Type: application/json

{
  "marca": "Toyota",
  "modelo": "Corolla Cross",
  "matricula": "BBB{{ts}}",
  "precioPorDia": 60.00,
  "disponible": false,
  "categoriaId": {{categoriaId}}
}

### ------------------------------------------------------------
### 6) Eliminar vehiculo (OK)
### ------------------------------------------------------------
DELETE {{baseUrl}}/{{vehiculoId}} HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 7) Entidad no encontrada -> 404
### ------------------------------------------------------------
GET {{baseUrl}}/999999 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 8) Integridad (matricula unica duplicada) -> 409
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "marca": "Ford",
  "modelo": "Focus",
  "matricula": "{{dupMatricula}}",
  "precioPorDia": 50.00,
  "disponible": true,
  "categoriaId": {{categoriaId}}
}

###
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "marca": "Ford",
  "modelo": "Fiesta",
  "matricula": "{{dupMatricula}}",
  "precioPorDia": 40.00,
  "disponible": true,
  "categoriaId": {{categoriaId}}
}

### ------------------------------------------------------------
### 9) Datos de entrada invalidos -> 400
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "marca": "",
  "modelo": "",
  "matricula": "",
  "precioPorDia": -1,
  "disponible": null,
  "categoriaId": null
}

### ------------------------------------------------------------
### 10) Error de dominio (categoria inexistente) -> 404
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "marca": "Nissan",
  "modelo": "Qashqai",
  "matricula": "CCC{{ts}}",
  "precioPorDia": 70.00,
  "disponible": true,
  "categoriaId": 999999
}

### ------------------------------------------------------------
### 11) Excepcion de filtro (sort invalido) -> 400
### ------------------------------------------------------------
GET {{baseUrl}}?sort=marca,invalido&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 12) Excepcion de filtro (size invalido) -> 400
### ------------------------------------------------------------
GET {{baseUrl}}?sort=id,asc&page=0&size=0 HTTP/1.1
Content-Type: application/json
