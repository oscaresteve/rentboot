@host = http://localhost:8090
@baseUrl = {{host}}/api/alquileres
@alquilerId = 1
@clienteId = 1
@vehiculoId = 1

### ------------------------------------------------------------
### 1) Crear alquiler (OK)
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "fechaInicio": "2026-02-01",
  "fechaFin": "2026-02-05",
  "precioTotal": 250.00,
  "clienteId": {{clienteId}},
  "vehiculoId": {{vehiculoId}}
}

### ------------------------------------------------------------
### 2) Obtener alquiler por id (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/{{alquilerId}} HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 3) Listar alquileres (paginacion + ordenacion)
### ------------------------------------------------------------
GET {{baseUrl}}?sort=id,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 4) Filtrar alquileres por cliente (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/cliente/{{clienteId}}?sort=id,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 5) Filtrar alquileres por vehiculo (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/vehiculo/{{vehiculoId}}?sort=id,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 6) Actualizar alquiler (OK)
### ------------------------------------------------------------
PUT {{baseUrl}}/{{alquilerId}} HTTP/1.1
Content-Type: application/json

{
  "fechaInicio": "2026-03-01",
  "fechaFin": "2026-03-07",
  "precioTotal": 420.00,
  "clienteId": {{clienteId}},
  "vehiculoId": {{vehiculoId}}
}

### ------------------------------------------------------------
### 7) Eliminar alquiler (OK)
### ------------------------------------------------------------
DELETE {{baseUrl}}/{{alquilerId}} HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 8) Entidad no encontrada -> 404
### ------------------------------------------------------------
GET {{baseUrl}}/999999 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 9) Integridad (FK cliente inexistente) -> 404
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "fechaInicio": "2026-04-01",
  "fechaFin": "2026-04-03",
  "precioTotal": 120.00,
  "clienteId": 999999,
  "vehiculoId": {{vehiculoId}}
}

### ------------------------------------------------------------
### 10) Datos de entrada invalidos -> 400
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "fechaInicio": null,
  "fechaFin": null,
  "precioTotal": -10,
  "clienteId": null,
  "vehiculoId": null
}

### ------------------------------------------------------------
### 11) Excepcion de filtro (sort invalido) -> 400
### ------------------------------------------------------------
GET {{baseUrl}}?sort=id,invalido&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 12) Excepcion de filtro (size invalido) -> 400
### ------------------------------------------------------------
GET {{baseUrl}}?sort=id,asc&page=0&size=0 HTTP/1.1
Content-Type: application/json
