@host = http://localhost:8090
@baseUrl = {{host}}/api/roles
@rolId = 1
@ts = {{$timestamp}}
@dupNombre = RolDuplicado{{ts}}

### ------------------------------------------------------------
### 1) Crear rol (OK)
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "ROL_TEST_{{ts}}"
}

### ------------------------------------------------------------
### 2) Obtener rol por id (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/{{rolId}} HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 3) Listar roles (paginacion + ordenacion)
### ------------------------------------------------------------
GET {{baseUrl}}?sort=nombre,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 4) Filtrar roles por nombre (OK)
### ------------------------------------------------------------
GET {{baseUrl}}/nombre/ROL?sort=nombre,asc&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 5) Actualizar rol (OK)
### ------------------------------------------------------------
PUT {{baseUrl}}/{{rolId}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "ROL_TEST_ACTUALIZADO_{{ts}}"
}

### ------------------------------------------------------------
### 6) Eliminar rol (OK)
### ------------------------------------------------------------
DELETE {{baseUrl}}/{{rolId}} HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 7) Entidad no encontrada -> 404
### ------------------------------------------------------------
GET {{baseUrl}}/999999 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 8) Integridad (nombre unico duplicado) -> 409
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "{{dupNombre}}"
}

###
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "{{dupNombre}}"
}

### ------------------------------------------------------------
### 9) Datos de entrada invalidos -> 400
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": ""
}

### ------------------------------------------------------------
### 10) Error de validacion de campos -> 400 (nombre > 50)
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "123456789012345678901234567890123456789012345678901"
}

### ------------------------------------------------------------
### 11) Excepcion de filtro (sort invalido) -> 400
### ------------------------------------------------------------
GET {{baseUrl}}?sort=nombre,invalido&page=0&size=5 HTTP/1.1
Content-Type: application/json

### ------------------------------------------------------------
### 12) Excepcion de filtro (size invalido) -> 400
### ------------------------------------------------------------
GET {{baseUrl}}?sort=id,asc&page=0&size=0 HTTP/1.1
Content-Type: application/json
