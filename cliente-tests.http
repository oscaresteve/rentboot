@host = http://localhost:8090
@baseUrl = {{host}}/api/clientes
@clienteId = 2

### ------------------------------------------------------------
### 1) Crear cliente
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "Cliente Test Uno",
  "email": "cliente.test.uno@example.com",
  "telefono": "600123123"
}

### ------------------------------------------------------------
### 2) Crear cliente invalido (validacion)
### ------------------------------------------------------------
POST {{baseUrl}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "",
  "email": "correo-invalido",
  "telefono": "123"
}

### ------------------------------------------------------------
### 3) Obtener cliente por id
### ------------------------------------------------------------
GET {{baseUrl}}/{{clienteId}} HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 4) Listar clientes (paginado + ordenado por id asc)
### ------------------------------------------------------------
GET {{baseUrl}}?page=0&size=5&sort=id,asc HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 5) Listar clientes (paginado + ordenado por nombre desc)
### ------------------------------------------------------------
GET {{baseUrl}}?page=0&size=5&sort=nombre,desc HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 6) Filtrar por nombre (path variable + paginacion + ordenacion)
### ------------------------------------------------------------
GET {{baseUrl}}/nombre/Cliente?page=0&size=5&sort=nombre,asc HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 7) Filtrar por email (path variable + paginacion + ordenacion)
### ------------------------------------------------------------
GET {{baseUrl}}/email/example.com?page=0&size=5&sort=email,asc HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 8) Filtrar por telefono (path variable + paginacion + ordenacion)
### ------------------------------------------------------------
GET {{baseUrl}}/telefono/600?page=0&size=5&sort=telefono,asc HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 9) Paginacion en filtro por nombre (segunda pagina)
### ------------------------------------------------------------
GET {{baseUrl}}/nombre/Cliente?page=1&size=3&sort=nombre,asc HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 10) Actualizar cliente
### ------------------------------------------------------------
PUT {{baseUrl}}/{{clienteId}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "Cliente Test Uno Actualizado",
  "email": "cliente.test.uno.actualizado@example.com",
  "telefono": "699999999"
}

### ------------------------------------------------------------
### 11) Eliminar cliente
### ------------------------------------------------------------
DELETE {{baseUrl}}/{{clienteId}} HTTP/1.1
Accept: application/json

### ------------------------------------------------------------
### 12) Obtener cliente eliminado (debe dar error)
### ------------------------------------------------------------
GET {{baseUrl}}/{{clienteId}} HTTP/1.1
Accept: application/json
